{
  "name": "discord-stage-recorder",
  "version": "1.0.0",
  "description": "Records Discord Stage sessions (OBS video + per-speaker audio), transcribes locally with Whisper, summarizes the Q&A, and publishes to YouTube, Google Drive and Discord.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "register": "node scripts/register-commands.js",
    "google-auth": "node scripts/google-auth.js",
    "process": "node scripts/process-recording.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.18.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "googleapis": "^144.0.0",
    "libsodium-wrappers": "^0.7.15",
    "obs-websocket-js": "^5.0.6",
    "opusscript": "^0.1.1",
    "prism-media": "^1.3.5"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@discordjs/opus@0.10.0": true
  }
}
