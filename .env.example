# ---------- Discord ----------
DISCORD_TOKEN=            # Bot token from https://discord.com/developers/applications
DISCORD_CLIENT_ID=        # Application ID (for registering slash commands)
DISCORD_GUILD_ID=         # Your server ID
DISCORD_POST_CHANNEL_ID=  # Text channel where recordings + summaries get posted
# Optional: only react to Stages in this channel (leave blank = any Stage channel in the server)
DISCORD_STAGE_CHANNEL_ID=

# ---------- OBS (Tools > WebSocket Server Settings in OBS) ----------
OBS_URL=ws://127.0.0.1:4455
OBS_PASSWORD=
# If OBS isn't running / unreachable, still record audio via the bot and continue (true/false)
OBS_OPTIONAL=true

# ---------- Whisper (local) ----------
# Path to whisper.cpp CLI. `brew install whisper-cpp` installs it as `whisper-cli`.
WHISPER_BIN=whisper-cli
# GGML model file. Download once with: ./setup-mac.sh
WHISPER_MODEL=./models/ggml-medium.en.bin
WHISPER_THREADS=8

# ---------- Anthropic (summaries) ----------
ANTHROPIC_API_KEY=
SUMMARY_MODEL=claude-sonnet-4-5

# ---------- Google (Drive; optionally YouTube) ----------
# OAuth "Desktop app" client from Google Cloud Console; run `npm run google-auth` once.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_PATH=./google-token.json
DRIVE_FOLDER_ID=                    # Drive folder to upload into (blank = root)
# Video always uploads to Drive. Set to true to also upload it to YouTube (off by default for now).
YOUTUBE_ENABLED=false
YOUTUBE_PRIVACY=unlisted            # public | unlisted | private
YOUTUBE_TITLE_PREFIX=Coaching Q&A – # Prepended to the Stage topic

# ---------- Misc ----------
RECORDINGS_DIR=./recordings
# Your name as it should appear in transcripts/summaries
COACH_NAME=Your Name
# Delete raw per-speaker WAVs after a successful run (true/false)
CLEANUP_RAW_AUDIO=true
